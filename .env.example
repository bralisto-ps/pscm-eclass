# Copy this file to ".env.local" for running on your own computer.
# On Netlify, add the same three values under Site configuration → Environment variables.

# Supabase → Project Settings → API (or "Connect")
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Must be exactly the same Gmail address as 'student_email_base' in supabase/schema.sql
VITE_STUDENT_EMAIL_BASE=YOUR-APP-ACCOUNT@gmail.com
